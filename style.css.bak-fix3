*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{height:100%;overflow:hidden;font-family:-apple-system,'SF Pro','Segoe UI',system-ui,sans-serif;background:#0a0e1a;color:#e8eef7;direction:rtl}

.page{position:fixed;inset:0;display:none;flex-direction:column;z-index:1}
.page.active{display:flex}

/* ===== Top Bar ===== */
.topbar{height:56px;display:flex;align-items:center;gap:2px;padding:0 6px;background:rgba(10,14,26,0.9);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;z-index:20}
.topbar .title{flex:1;text-align:center;font-weight:600;font-size:14px;padding:0 4px;overflow:hidden}
.topbar .title small{display:block;font-size:10px;color:#6b7280;font-weight:400;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.iconbtn{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#e8eef7;font-size:19px;cursor:pointer;transition:all .15s;flex-shrink:0}
.iconbtn:active{background:rgba(255,255,255,0.1);transform:scale(0.92)}
.iconbtn.accent{color:#00d9ff}
.iconbtn.on{background:linear-gradient(135deg,#ff9500,#cc6600);color:#fff;box-shadow:0 0 16px rgba(255,149,0,0.5)}

/* ===== Home ===== */
#page-home{overflow-y:auto}
.hero{padding:64px 20px 24px;text-align:center}
.hero-icon{font-size:68px;line-height:1;filter:drop-shadow(0 16px 40px rgba(0,217,255,0.55))}
.hero h1{font-size:30px;font-weight:800;letter-spacing:-.5px;margin:16px 0 4px;background:linear-gradient(135deg,#fff 40%,#00d9ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{color:#6b7280;font-size:13px;font-weight:500}
.home-pad{padding:16px 20px}
.bigbtn{width:100%;padding:17px;border-radius:16px;border:none;font-size:15px;font-weight:700;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:10px;font-family:inherit}
.bigbtn.primary{background:linear-gradient(135deg,#00d9ff,#0088cc);color:#000;box-shadow:0 12px 32px rgba(0,217,255,0.4)}
.bigbtn.primary:active{transform:scale(0.97)}
.bigbtn.ghost{background:rgba(255,255,255,0.04);color:#00d9ff;border:1px solid rgba(0,217,255,0.25);margin-top:10px}
.proj-list{padding:0 20px 40px}
.proj-card{background:linear-gradient(135deg,rgba(30,37,53,0.7),rgba(20,25,38,0.7));border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:all .15s}
.proj-card:active{transform:scale(0.98);border-color:rgba(0,217,255,0.3)}
.proj-card .info{flex:1;min-width:0}
.proj-card .name{font-weight:700;font-size:15px;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#00d9ff}
.proj-card .meta{font-size:11px;color:#6b7280}
.proj-card .actions{display:flex;gap:6px;flex-shrink:0}
.minibtn{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.06);border:none;color:#e8eef7;font-size:15px;cursor:pointer}
.minibtn.danger{color:#ef4444;background:rgba(239,68,68,0.12)}

/* ===== Form ===== */
.scroll-form{padding:18px 20px 40px;overflow-y:auto;flex:1}
.scroll-form label{display:block;margin:12px 0 6px;color:#8899aa;font-size:12px;font-weight:600}
.scroll-form input,.scroll-form select{width:100%;padding:14px;border-radius:14px;border:1px solid rgba(255,255,255,0.06);background:rgba(22,27,40,0.8);color:#e8eef7;font-size:15px;font-family:inherit;outline:none;transition:all .15s}
.scroll-form input:focus,.scroll-form select:focus{border-color:#00d9ff}
.scroll-form input[type=color]{padding:4px;height:52px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

/* ===== Canvas ===== */
.canvas-wrap{flex:1;position:relative;overflow:hidden}
#planCanvas,#scene3d{display:block;width:100%;height:100%;touch-action:none}
#wallCanvas,#ceilCanvas{display:block;width:100%;height:100%;background:#fafbfc;touch-action:none}

/* ===== Bottom Dock ===== */
.dock{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:4px;padding:6px 8px;background:rgba(15,20,32,0.94);backdrop-filter:blur(30px);border:1px solid rgba(255,255,255,0.08);border-radius:22px;box-shadow:0 12px 40px rgba(0,0,0,0.7);z-index:15;max-width:calc(100% - 20px);overflow-x:auto;scrollbar-width:none}
.dock::-webkit-scrollbar{display:none}
.dock-btn{min-width:48px;height:48px;padding:0 6px;border-radius:14px;background:transparent;border:none;color:#8899aa;font-size:10px;font-weight:700;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family:inherit;flex-shrink:0;transition:all .15s}
.dock-btn .ico{font-size:20px;line-height:1}
.dock-btn:active{background:rgba(255,255,255,0.08)}
.dock-btn.active{color:#00d9ff;background:rgba(0,217,255,0.15)}

/* ===== Hint ===== */
.hint{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.9);backdrop-filter:blur(20px);color:#00d9ff;padding:8px 16px;border-radius:20px;font-size:12px;font-weight:600;display:none;border:1px solid rgba(0,217,255,0.3);white-space:nowrap;max-width:calc(100% - 24px);overflow:hidden;text-overflow:ellipsis;z-index:12}
.hint.show{display:block;animation:hin .3s}

/* ===== Face tabs ===== */
.face-tabs{display:flex;gap:6px;padding:10px 12px;background:rgba(10,14,26,0.9);border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;justify-content:center}
.face-tab{padding:8px 20px;border-radius:22px;border:none;background:rgba(255,255,255,0.05);color:#8899aa;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .2s}
.face-tab.active{background:linear-gradient(135deg,#00d9ff,#0088cc);color:#000;box-shadow:0 4px 16px rgba(0,217,255,0.4)}

/* ===== Joysticks ===== */
.joy{position:absolute;bottom:90px;width:110px;height:110px;border-radius:50%;background:rgba(0,217,255,0.08);border:2px solid rgba(0,217,255,0.3);display:none;z-index:15;touch-action:none;align-items:center;justify-content:center;backdrop-filter:blur(10px)}
#joyL{left:16px}
#joyR{right:16px;background:rgba(255,149,0,0.08);border-color:rgba(255,149,0,0.3)}
.joyK,.joyK2{width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#00d9ff,#0088cc);pointer-events:none;box-shadow:0 4px 16px rgba(0,217,255,0.5)}
#joyR .joyK2{background:linear-gradient(135deg,#ff9500,#cc6600);box-shadow:0 4px 16px rgba(255,149,0,0.5)}
#exitWalk{position:absolute;top:14px;right:14px;width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#ff2b2b,#cc0000);font-size:20px;display:none;z-index:16;padding:0;color:#fff;border:none;cursor:pointer}
#exitWalk.show{display:flex;align-items:center;justify-content:center}

/* ===== Panel & Report ===== */
.panel-view,.report-view{padding:16px 20px 40px;overflow-y:auto;flex:1}
.panel-slot{background:rgba(30,37,53,0.6);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;border-right:4px solid #00d9ff}
.panel-slot .pos{width:34px;height:34px;border-radius:10px;background:rgba(0,217,255,0.15);color:#00d9ff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0}
.panel-slot .info{flex:1;min-width:0}
.panel-slot .name{font-weight:700;font-size:13px}
.panel-slot .meta{font-size:11px;color:#6b7280;margin-top:2px}
.panel-slot .rating{font-family:monospace;font-size:12px;color:#00d9ff;font-weight:700}
.report-view h3{color:#00d9ff;margin:20px 0 10px;font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid rgba(0,217,255,0.2)}
.report-view h3:first-child{margin-top:0}
.report-view .row{display:flex;justify-content:space-between;padding:11px 14px;background:rgba(30,37,53,0.5);border-radius:10px;margin-bottom:5px;font-size:13px}
.report-view .row.tot{background:linear-gradient(135deg,#00d9ff,#0088cc);color:#000;font-weight:800}
.report-view .row.warn{background:rgba(239,68,68,0.15);border-left:3px solid #ef4444}
.report-view .row.ok{background:rgba(34,197,94,0.12);border-left:3px solid #22c55e}

/* ===== Modal ===== */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px)}
.modal.show{display:flex}
.modal-box{background:linear-gradient(135deg,#1e2535,#14192a);border-radius:22px;padding:22px;max-width:440px;width:100%;max-height:80vh;overflow-y:auto;border:1px solid rgba(255,255,255,0.08);box-shadow:0 24px 80px rgba(0,0,0,0.8)}
.modal-box h3{color:#00d9ff;margin-bottom:16px;font-size:16px;font-weight:700}
.modal-box label{display:block;margin:10px 0 5px;color:#8899aa;font-size:12px;font-weight:600}
.modal-box input,.modal-box select{width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(10,14,26,0.8);color:#e8eef7;font-size:14px;font-family:inherit;outline:none}
.modal-box input:focus{border-color:#00d9ff}
.modal-actions{display:flex;gap:8px;margin-top:18px}
.modal-actions button{flex:1;padding:14px;border-radius:14px;font-weight:700;font-size:14px;border:none;cursor:pointer;font-family:inherit;background:rgba(255,255,255,0.06);color:#e8eef7;transition:all .15s}
.modal-actions .btn-ok{background:linear-gradient(135deg,#00d9ff,#0088cc);color:#000}
.modal-actions .btn-del{background:rgba(239,68,68,0.15);color:#ef4444;flex:0 0 auto;padding:14px 18px}

.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.room-grid button{padding:14px 8px;border-radius:14px;border:none;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:6px;transition:all .15s;color:#000}
.room-grid button .ico{font-size:22px}
.room-grid button:active{transform:scale(0.96)}

.toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);background:linear-gradient(135deg,#00d9ff,#0088cc);color:#000;padding:12px 22px;border-radius:24px;font-size:13px;font-weight:700;z-index:200;opacity:0;transition:all .3s;pointer-events:none;box-shadow:0 8px 28px rgba(0,217,255,0.5);white-space:nowrap;max-width:calc(100% - 32px);overflow:hidden;text-overflow:ellipsis}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.warn{background:linear-gradient(135deg,#ef4444,#cc0000);color:#fff}

@keyframes hin{from{opacity:0;transform:translateX(-50%) translateY(-8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
